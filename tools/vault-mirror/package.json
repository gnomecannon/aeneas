{
  "name": "@everythingapp/vault-mirror",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Mirrors a local Obsidian vault with the EverythingApp hub /vault routes",
  "bin": { "vault-mirror": "./src/cli.ts" },
  "scripts": {
    "start": "tsx src/cli.ts",
    "once": "tsx src/cli.ts once",
    "watch": "tsx src/cli.ts watch",
    "dry-run": "tsx src/cli.ts dry-run",
    "fake-hub": "tsx scripts/fake-hub.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=20" }
}
