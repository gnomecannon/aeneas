# EverythingApp hub configuration. Copy to hub/.env and edit.
# Paths are resolved relative to the hub directory when not absolute.

# HTTP port the hub listens on.
EA_PORT=8787
# Bearer token every client sends. Generate one: openssl rand -hex 32
EA_TOKEN=change-me-to-a-random-string-of-32-or-more-characters
# Where hub.sqlite lives. Defaults to ./data inside hub when unset.
EA_DATA_DIR=./data
# Markdown vault (Obsidian mirror). Defaults to <EA_DATA_DIR>/vault.
EA_VAULT_DIR=./data/vault
# Nightly VACUUM INTO copies go here, encrypted (hub-YYYYMMDD-HHMMSS.sqlite.age), 30 day retention. Defaults to <EA_DATA_DIR>/backups.
EA_BACKUP_DIR=./data/backups
# The work space key (32 bytes, made on first start). Keep it outside the data folder and out of every backup:
# erasing the work space destroys it, which leaves the work items in older copies unreadable. Defaults to <EA_DATA_DIR>/work.key.
# EA_WORK_KEY_FILE=/home/you/.config/everythingapp/work.key
# The backup key (age, made on first start): every backup and copy sent elsewhere is encrypted to it. Defaults to
# backup.key next to the work key. Keep its recovery key (POST /setup/backup/reveal) in the password manager.
# EA_BACKUP_KEY_FILE=/home/you/.config/everythingapp/backup.key
# Local model server. Leave empty to disable the local backend.
# On a host without MagicDNS use the tailnet IP, not the hostname.
EA_OLLAMA_URL=http://gpu-box.your-tailnet.ts.net:11434
# The model. Empty: none until the Welcome page picks one that fits this machine (it is kept in <data>/ai.json).
EA_OLLAMA_MODEL=
# keep_alive sent with every chat so Ollama keeps the model loaded between messages. 5 minutes (the default) frees
# the graphics card soon after; longer saves the reload on the first message after a pause.
EA_OLLAMA_KEEP_ALIVE=5m
# Context window asked of Ollama, in tokens. Empty (the default): automatic, the smallest that holds the system
# prompt, every tool, a reply and some history (32768 with today's tools; GET /status shows it under ai.context).
# A smaller value is raised to that, since Ollama silently drops the start of a longer request; a larger one is kept.
EA_OLLAMA_NUM_CTX=
# Cloud backend. Only used when a request says allow_cloud or EA_ALLOW_CLOUD_DEFAULT is true.
EA_ANTHROPIC_API_KEY=
EA_ANTHROPIC_MODEL=claude-sonnet-5-5
EA_ALLOW_CLOUD_DEFAULT=false
# Timezone used for reminder repeats and the dashboard day window. Empty: this machine's own.
EA_TZ=
# Who besides this machine may use EA_TOKEN (comma separated tailnet addresses or Tailscale logins; * for anyone).
# Empty: only scripts on this machine. Devices use their own keys from a pairing code.
EA_MAIN_KEY_FROM=
# 1 lets EA_TOKEN also come in ?token= (an old sensor board; use the sensor key instead). Off by default.
EA_MAIN_KEY_IN_QUERY=
# Browser origins besides the Windows app and the web dev server that may call the hub from a page.
EA_CORS_ORIGINS=
# Planner day window (HH:MM local). Blocks and free slots live inside it.
EA_DAY_START=09:00
EA_DAY_END=23:00
# Local time the daily digest notify is emitted, once per day.
EA_DIGEST_TIME=09:00
# Hours an activity log may run before the hub asks whether it is still on purpose (activity check-in).
EA_FOCUS_CHECK_HOURS=3
# An activity nobody stopped ends after this many hours, at its first check-in (0 never).
EA_FOCUS_MAX_HOURS=12
# Optional voice adapter (same request shape as Ollama /api/chat). Used first for task_type draft.
EA_ADAPTER_URL=
# Model name sent to the adapter. Defaults to EA_OLLAMA_MODEL when empty.
EA_ADAPTER_MODEL=
# Optional seed directory override. Defaults to <repo>/deploy/seed.
# EA_SEED_DIR=../deploy/seed
# Tuning. Milliseconds.
EA_AI_TIMEOUT_MS=120000
EA_CLASSIFY_TIMEOUT_MS=4000
EA_REMINDER_INTERVAL_MS=30000
# Set to 1 to use a canned fake AI backend (tests only).
EA_AI_FAKE=0
# Set to 0 to silence the one-line-per-request log.
EA_LOG_REQUESTS=1

# Resolver for *.ts.net names when the host has no MagicDNS.
EA_TS_RESOLVER=100.100.100.100

# Interface to bind. Keep 127.0.0.1 behind Tailscale Serve; use 0.0.0.0 only for a LAN-only setup.
EA_BIND_HOST=127.0.0.1

# Backup monitors (type backup) read ProjectBackup jobs by these names, as job=name pairs separated by commas.
# A job left out keeps its default, shown here. Mac: launchd labels. Windows: Task Scheduler task names.
# Linux: systemd units, with a monthly restore test as well.
# EA_BACKUP_MAC_JOBS=backup=local.projectbackup.snapshot,verify=local.projectbackup.verify
# EA_BACKUP_WINDOWS_TASKS=backup=Project Backup Snapshot,verify=Project Backup Verify
# EA_BACKUP_LINUX_UNITS=backup=project-backup.service,verify=project-backup-verify.service,restore=project-backup-restore-test.service

# Shared image service (image generation). Empty URL turns it off; the token stays on the hub.
# EA_IMAGE_SERVICE_URL=http://image-host:8794
# EA_IMAGE_SERVICE_TOKEN=
# Workers of the image service a person or the assistant may pick by hand, as id=label pairs separated by commas.
# Empty: only Auto (the service chooses). Example: EA_IMAGE_WORKERS=gpu-a=Big GPU,gpu-b=Desktop GPU
EA_IMAGE_WORKERS=
