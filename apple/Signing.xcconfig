// Who signs the Apple apps, and the name every id is built from. Everything else follows from these two:
// bundle ids ($(EA_BUNDLE_PREFIX).everythingapp, .widgets, .share, .watchkitapp, ...), the app group
// (group.$(EA_BUNDLE_PREFIX).everythingapp) that the apps, widgets and Watch share, and the Keychain group the device
// key is kept in.
//
// To build your own copy, do not edit this file: copy Signing.local.xcconfig.example to Signing.local.xcconfig (not
// tracked by git) and put your team id and your own reverse-domain name there. See apple/README.md, "Build it yourself".
EA_TEAM_ID = 73Y4G5XWP5
EA_BUNDLE_PREFIX = com.gnomecannon

#include? "Signing.local.xcconfig"
