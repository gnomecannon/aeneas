{
  "name": "EverythingApp",
  "short_name": "Everything",
  "description": "Capture, tasks, reminders, notes and logs on one hub.",
  "id": "./",
  "start_url": "./#/now",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5f4f1",
  "theme_color": "#f5f4f1",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Capture", "url": "./#/capture", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Now", "url": "./#/now", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
