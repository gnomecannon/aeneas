{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Every platform: the app's windows, notifications, links and its setup file",
  "windows": [
    "main",
    "capture",
    "widget",
    "pop-*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "notification:default",
    "opener:allow-open-url",
    "deep-link:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPCONFIG/config.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$APPCONFIG/config.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$APPCONFIG/config.json"
        }
      ]
    }
  ]
}
